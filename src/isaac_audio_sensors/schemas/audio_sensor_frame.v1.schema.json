{
  "$id": "https://isaac-audio-sensors.dev/schemas/audio_sensor_frame.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Stable AudioSensorFrame v1 trace contract. The schema_version is separate from the Python package version. Public fields, unit meanings, timestamp semantics, provenance values, coordinate convention, ambiguity representation, stable backend identifiers, and bearing-sector semantics are compatibility commitments for v1.",
  "properties": {
    "aggregate_per_mic_rms": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Per-microphone aggregate RMS values in linear units.",
      "type": "object"
    },
    "array_id": {
      "description": "Microphone-array identifier.",
      "minLength": 1,
      "type": "string"
    },
    "array_pose": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": true,
          "description": "World-frame pose using x_forward_y_right_z_up_clockwise_bearing.",
          "properties": {
            "coordinate_convention": {
              "const": "x_forward_y_right_z_up_clockwise_bearing",
              "description": "Stable v1 coordinate and bearing convention.",
              "type": "string"
            },
            "frame": {
              "description": "Coordinate frame name; v1 examples use world.",
              "minLength": 1,
              "type": "string"
            },
            "orientation_xyzw": {
              "description": "Quaternion orientation in x, y, z, w order.",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 4,
                  "minItems": 4,
                  "type": "array"
                }
              ]
            },
            "position_m": {
              "description": "Position in meters.",
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            }
          },
          "required": [
            "position_m",
            "orientation_xyzw",
            "frame",
            "coordinate_convention"
          ],
          "type": "object"
        }
      ]
    },
    "backend_id": {
      "description": "Public backend identifier such as geometry_only, tdoa_synthetic, room_acoustics, or room_acoustics_srp.",
      "minLength": 1,
      "type": "string"
    },
    "coordinate_convention": {
      "const": "x_forward_y_right_z_up_clockwise_bearing",
      "description": "Stable v1 coordinate and bearing convention.",
      "type": "string"
    },
    "detections": {
      "description": "Detected, scheduled, or externally described events.",
      "items": {
        "additionalProperties": true,
        "properties": {
          "audio_asset_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "class_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "detection_id": {
            "minLength": 1,
            "type": "string"
          },
          "detection_mode": {
            "minLength": 1,
            "type": "string"
          },
          "diagnostics": {
            "type": "object"
          },
          "doa": {
            "additionalProperties": true,
            "description": "Direction-of-arrival estimate with explicit candidate and ambiguity representation.",
            "properties": {
              "ambiguity_class": {
                "description": "Stable ambiguity class namespace when a bearing is not unique.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "ambiguity_reason": {
                "description": "Human-readable explanation for ambiguity_class.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "bearing_confidence": {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              "bearing_sector": {
                "description": "Canonical 8-sector label using corrected half-open v1 sector semantics.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "candidate_bearing_deg": {
                "description": "Candidate bearings in degrees clockwise from array forward.",
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "candidate_elevation_deg": {
                "description": "Optional additive v1 field: candidate elevations in degrees up from the array's forward/right plane. Absent in older v1 traces.",
                "items": {
                  "maximum": 90.0,
                  "minimum": -90.0,
                  "type": "number"
                },
                "type": "array"
              },
              "estimated_bearing_deg": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "estimated_elevation_deg": {
                "description": "Optional additive v1 field: elevation in degrees up from the array's forward/right plane when the producer can resolve it (rank-3 layouts). Absent in older v1 traces.",
                "maximum": 90.0,
                "minimum": -90.0,
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "estimated_bearing_deg",
              "candidate_bearing_deg",
              "bearing_sector",
              "bearing_confidence",
              "ambiguity_class",
              "ambiguity_reason"
            ],
            "type": "object"
          },
          "ground_truth_bearing_deg": {
            "type": [
              "number",
              "null"
            ]
          },
          "ground_truth_elevation_deg": {
            "description": "Optional additive v1 field: oracle source elevation in degrees up from the array's forward/right plane. Absent in older v1 traces.",
            "maximum": 90.0,
            "minimum": -90.0,
            "type": [
              "number",
              "null"
            ]
          },
          "occluded": {
            "description": "Optional additive v1 field: true when the producer determined the direct source-to-array path is occluded (e.g. Isaac raycast occlusion). Absent in older v1 traces.",
            "type": "boolean"
          },
          "per_mic_delay_s": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "per_mic_rms": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object"
          },
          "source_distance_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_pose": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": true,
                "description": "World-frame pose using x_forward_y_right_z_up_clockwise_bearing.",
                "properties": {
                  "coordinate_convention": {
                    "const": "x_forward_y_right_z_up_clockwise_bearing",
                    "description": "Stable v1 coordinate and bearing convention.",
                    "type": "string"
                  },
                  "frame": {
                    "description": "Coordinate frame name; v1 examples use world.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "orientation_xyzw": {
                    "description": "Quaternion orientation in x, y, z, w order.",
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 4,
                        "minItems": 4,
                        "type": "array"
                      }
                    ]
                  },
                  "position_m": {
                    "description": "Position in meters.",
                    "items": {
                      "type": "number"
                    },
                    "maxItems": 3,
                    "minItems": 3,
                    "type": "array"
                  }
                },
                "required": [
                  "position_m",
                  "orientation_xyzw",
                  "frame",
                  "coordinate_convention"
                ],
                "type": "object"
              }
            ]
          },
          "timestamp_ms": {
            "type": "integer"
          }
        },
        "required": [
          "detection_id",
          "source_id",
          "class_label",
          "detection_mode",
          "timestamp_ms",
          "ground_truth_bearing_deg",
          "source_distance_m",
          "doa",
          "source_pose",
          "per_mic_delay_s",
          "per_mic_rms",
          "audio_asset_path",
          "diagnostics"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "diagnostics": {
      "description": "Open-ended additive diagnostics; stable namespaces keep their documented meanings.",
      "type": "object"
    },
    "end_time_s": {
      "description": "Exclusive frame-window end time in seconds.",
      "type": [
        "number",
        "null"
      ]
    },
    "frame_id": {
      "description": "Stable machine-readable frame identifier.",
      "minLength": 1,
      "type": "string"
    },
    "frame_index": {
      "description": "Non-negative producer frame index when present.",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "frame_name": {
      "description": "Human-readable frame name; defaults to frame_id.",
      "minLength": 1,
      "type": "string"
    },
    "max_events": {
      "description": "Non-negative deterministic detection cap when set.",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "provenance": {
      "description": "Stable producer provenance namespace.",
      "enum": [
        "isaac_live",
        "replay/trace",
        "room_acoustics",
        "synthetic/core"
      ]
    },
    "sample_rate_hz": {
      "description": "Audio sample rate in Hz when known.",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "schema_version": {
      "const": "ias.audio_sensor_frame.v1",
      "description": "Stable frame schema id for all compatible v1 frames."
    },
    "start_time_s": {
      "description": "Inclusive frame-window start time in seconds.",
      "type": [
        "number",
        "null"
      ]
    },
    "timestamp_ms": {
      "description": "Frame timestamp in integer milliseconds.",
      "type": "integer"
    },
    "units": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Stable unit names and meanings for v1 fields.",
      "properties": {
        "bearing": {
          "const": "deg_clockwise_from_array_forward",
          "type": "string"
        },
        "distance": {
          "const": "m",
          "type": "string"
        },
        "elevation": {
          "const": "deg_up_from_array_horizontal",
          "type": "string"
        },
        "gain": {
          "const": "dB",
          "type": "string"
        },
        "orientation": {
          "const": "quaternion_xyzw",
          "type": "string"
        },
        "position": {
          "const": "m",
          "type": "string"
        },
        "rms": {
          "const": "linear",
          "type": "string"
        },
        "sample_rate": {
          "const": "Hz",
          "type": "string"
        },
        "time": {
          "const": "s",
          "type": "string"
        },
        "timestamp": {
          "const": "ms",
          "type": "string"
        }
      },
      "required": [
        "bearing",
        "distance",
        "gain",
        "orientation",
        "position",
        "rms",
        "sample_rate",
        "time",
        "timestamp"
      ],
      "type": "object"
    },
    "waveform_paths": {
      "description": "Optional producer artifact paths.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "frame_id",
    "frame_name",
    "timestamp_ms",
    "start_time_s",
    "end_time_s",
    "sample_rate_hz",
    "frame_index",
    "backend_id",
    "array_id",
    "array_pose",
    "coordinate_convention",
    "units",
    "provenance",
    "max_events",
    "detections",
    "aggregate_per_mic_rms",
    "waveform_paths",
    "diagnostics"
  ],
  "title": "Isaac Audio Sensors AudioSensorFrame v1",
  "type": "object"
}
