                int[] faceVertexIndices = [0, 1, 2, 3]
                custom float ias:absorption = 0.4
                custom bool ias:acoustic_enabled = 1
                custom float ias:scattering = 0
                point3f[] points = [(3, -2.5, 0), (3, 2.5, 0), (3, 2.5, 3), (3, -2.5, 3)]
                uniform token purpose = "guide"
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Face4"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                custom float ias:absorption = 0.4
                custom bool ias:acoustic_enabled = 1
