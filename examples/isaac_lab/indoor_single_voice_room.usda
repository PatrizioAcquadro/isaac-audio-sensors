#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def "Room"
    {
        def Cube "Wall0"
        {
            custom float ias:absorption = 0.4
            custom bool ias:acoustic_enabled = 0
            custom float ias:scattering = 0
            double size = 1
            float3 xformOp:scale = (6, 5, 0.1)
            double3 xformOp:translate = (0, 0, -0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Wall1"
        {
            custom float ias:absorption = 0.4
            custom bool ias:acoustic_enabled = 0
            custom float ias:scattering = 0
            double size = 1
            float3 xformOp:scale = (6, 5, 0.1)
            double3 xformOp:translate = (0, 0, 3.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Wall2"
        {
            custom float ias:absorption = 0.4
            custom bool ias:acoustic_enabled = 0
            custom float ias:scattering = 0
            double size = 1
            float3 xformOp:scale = (0.1, 5, 3)
            double3 xformOp:translate = (-3.05, 0, 1.5)
