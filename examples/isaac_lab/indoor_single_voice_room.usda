            custom float ias:scattering = 0
            double size = 1
            float3 xformOp:scale = (6, 0.1, 3)
            double3 xformOp:translate = (0, -2.55, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Wall5"
        {
            custom float ias:absorption = 0.4
            custom bool ias:acoustic_enabled = 0
            custom float ias:scattering = 0
            double size = 1
            float3 xformOp:scale = (6, 0.1, 3)
            double3 xformOp:translate = (0, 2.55, 1.5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def "Envelope"
        {
            def Mesh "Face0"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                custom float ias:absorption = 0.4
                custom bool ias:acoustic_enabled = 1
                custom float ias:scattering = 0
                point3f[] points = [(-3, -2.5, 0), (3, -2.5, 0), (3, 2.5, 0), (-3, 2.5, 0)]
                uniform token purpose = "guide"
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Face1"
            {
                int[] faceVertexCounts = [4]
                int[] faceVertexIndices = [0, 1, 2, 3]
                custom float ias:absorption = 0.4
                custom bool ias:acoustic_enabled = 1
                custom float ias:scattering = 0
                point3f[] points = [(-3, -2.5, 3), (3, -2.5, 3), (3, 2.5, 3), (-3, 2.5, 3)]
                uniform token purpose = "guide"
                uniform token subdivisionScheme = "none"
            }

            def Mesh "Face2"
            {
