include README.md
include LICENSE
include NOTICE
include CHANGELOG.md
include CITATION.cff
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include Makefile
include pyproject.toml
recursive-include configs *.toml
recursive-include docs *.md *.json
include docs/schemas/audio_dataset_manifest.v1.schema.json
include docs/schemas/audio_calibration_profile.v1.schema.json
exclude docs/reference_rig_hardware_environment.md
recursive-exclude docs/development *
recursive-exclude docs/evidence *
recursive-include examples *.md *.py *.json *.ndjson
recursive-include examples/manifests *.md *.json
recursive-include examples/calibration *.md *.json
recursive-include exts *.toml *.py *.md *.svg *.json
recursive-include scripts *.py
recursive-include src/isaac_audio_sensors/core/plugins *.py
recursive-include tests *.py
recursive-include .github *.yml
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
global-exclude .env
global-exclude .env.*
global-exclude *.wav
global-exclude *.mp4
global-exclude *.mov
global-exclude *.png
global-exclude *.jpg
global-exclude *.jpeg
global-exclude *.pdf
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
prune outputs
prune runs
prune data
prune generated
prune build
prune dist
prune .venv
prune venv
prune .local-goals
prune .pytest_cache
prune .ruff_cache
prune .mypy_cache
prune .agents
prune .codex
prune src/*.egg-info
include exts/isaac_audio_sensors.omni/data/preview.png
