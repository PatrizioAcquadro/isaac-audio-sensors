{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_session_preflight.v2.schema.json",
  "title": "S4.4 amendment-03 truthful live-readiness session preflight v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","amendment_id","session_id","session_date_local","recorded_at_local","collected_at_utc","checks","identity_contract_sha256","observations","preflight_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_session_preflight.v2"},
    "status": {"const": "passed"},
    "amendment_id": {"const": "s4_4_data_expansion_amendment_03"},
    "session_id": {"enum": ["fit_b","prospective_holdout"]},
    "session_date_local": {"type": "string", "format": "date"},
    "recorded_at_local": {"type": "string", "format": "date-time"},
    "collected_at_utc": {"type": "string", "format": "date-time"},
    "checks": {"type": "object", "minProperties": 12, "maxProperties": 12, "additionalProperties": {"const": "passed"}},
    "identity_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observations": {"type": "object"},
    "preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
