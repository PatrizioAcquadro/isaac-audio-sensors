{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/isaac-audio-sensors/s4_8_recovery_unseen_holdout_binding.v1.schema.json",
  "title": "S4.8 recovery amendment 02 unseen-holdout binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "amendment_id",
    "holdout_id",
    "status",
    "preregistration_commit",
    "precollection_seal",
    "partition_manifest",
    "session_manifest",
    "holdout_seal",
    "observation_root",
    "planned_take_count",
    "leakage_group_count",
    "scientifically_opened"
  ],
  "properties": {
    "schema": {"const": "ias.s4_8.recovery_unseen_holdout_binding.v1"},
    "amendment_id": {"const": "s4_8_recovery_amendment_02"},
    "holdout_id": {"const": "s4_8_recovery_amendment_02_unseen_holdout"},
    "status": {"const": "sealed_unopened"},
    "preregistration_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "precollection_seal": {"$ref": "#/$defs/artifact"},
    "partition_manifest": {"$ref": "#/$defs/artifact"},
    "session_manifest": {"$ref": "#/$defs/artifact"},
    "holdout_seal": {"$ref": "#/$defs/artifact"},
    "observation_root": {
      "const": "dataset/S4.4/amendments/s4_4_data_expansion_amendment_04/attempts"
    },
    "planned_take_count": {"const": 47},
    "leakage_group_count": {"const": 15},
    "scientifically_opened": {"const": false}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^/].*"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
