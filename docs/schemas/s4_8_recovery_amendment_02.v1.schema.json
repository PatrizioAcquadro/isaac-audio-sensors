{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/isaac-audio-sensors/s4_8_recovery_amendment_02.v1.schema.json",
  "title": "S4.8 forward-only recovery amendment 02 preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "amendment_id",
    "status",
    "prior_terminal_runs",
    "scientific_preregistration",
    "preliminary_readiness",
    "unseen_holdout",
    "future_attempt"
  ],
  "properties": {
    "schema": {"const": "ias.s4_8.recovery_amendment_02.v1"},
    "amendment_id": {"const": "s4_8_recovery_amendment_02"},
    "status": {"const": "prepared_awaiting_preliminary_readiness"},
    "prior_terminal_runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/originalRun"},
        {"$ref": "#/$defs/recoveryRun"}
      ]
    },
    "scientific_preregistration": {"$ref": "#/$defs/scientificPreregistration"},
    "preliminary_readiness": {"$ref": "#/$defs/preliminaryReadiness"},
    "unseen_holdout": {"$ref": "#/$defs/unseenHoldout"},
    "future_attempt": {"$ref": "#/$defs/futureAttempt"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^[^/].*"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "originalRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "source_commit",
        "grant_id",
        "terminal_status",
        "evaluation_state",
        "scientific_status",
        "failure_gate",
        "artifacts"
      ],
      "properties": {
        "run_id": {"const": "original_s4_8"},
        "source_commit": {"const": "b0d5575feded9f37316bff8ed4b62483084587bd"},
        "grant_id": {"type": "string", "minLength": 1},
        "terminal_status": {"const": "failed"},
        "evaluation_state": {"const": "not_evaluated"},
        "scientific_status": {"const": "not_evaluated"},
        "failure_gate": {"type": "null"},
        "artifacts": {"$ref": "#/$defs/artifactMap"}
      }
    },
    "recoveryRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "source_commit",
        "grant_id",
        "terminal_status",
        "evaluation_state",
        "scientific_status",
        "failure_gate",
        "artifacts"
      ],
      "properties": {
        "run_id": {"const": "recovery_amendment_01"},
        "source_commit": {"const": "9d02c14f4b0b2b21f3f38ce468d4cbcde14c08b8"},
        "grant_id": {"type": "string", "minLength": 1},
        "terminal_status": {"const": "failed"},
        "evaluation_state": {"const": "evaluation_completed"},
        "scientific_status": {"const": "failed"},
        "failure_gate": {"const": "evaluation_input_contract_rejected"},
        "artifacts": {"$ref": "#/$defs/artifactMap"}
      }
    },
    "scientificPreregistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_fix_commit",
        "producer_source_path",
        "producer_source_sha256",
        "criteria_config_path",
        "criteria_config_sha256",
        "criteria_schema_path",
        "criteria_schema_sha256",
        "criteria_spec_path",
        "criteria_spec_sha256",
        "design_template_path",
        "design_template_sha256",
        "design_template_metadata_only",
        "criteria_unchanged",
        "readiness_criterion_count",
        "stretch_criterion_count",
        "readiness_pass_rule",
        "planned_take_count",
        "leakage_group_count",
        "stratum_counts",
        "consumed_observations_reuse_forbidden",
        "post_hoc_threshold_or_scenario_change_forbidden"
      ],
      "properties": {
        "producer_fix_commit": {"const": "3738554f1fcfcf906eefcf26871d56ece21f11e4"},
        "producer_source_path": {"$ref": "#/$defs/path"},
        "producer_source_sha256": {"$ref": "#/$defs/sha256"},
        "criteria_config_path": {"$ref": "#/$defs/path"},
        "criteria_config_sha256": {"$ref": "#/$defs/sha256"},
        "criteria_schema_path": {"$ref": "#/$defs/path"},
        "criteria_schema_sha256": {"$ref": "#/$defs/sha256"},
        "criteria_spec_path": {"$ref": "#/$defs/path"},
        "criteria_spec_sha256": {"$ref": "#/$defs/sha256"},
        "design_template_path": {"$ref": "#/$defs/path"},
        "design_template_sha256": {"$ref": "#/$defs/sha256"},
        "design_template_metadata_only": {"const": true},
        "criteria_unchanged": {"const": true},
        "readiness_criterion_count": {"const": 23},
        "stretch_criterion_count": {"const": 6},
        "readiness_pass_rule": {"const": "all_23_readiness_criteria_pass"},
        "planned_take_count": {"const": 47},
        "leakage_group_count": {"const": 15},
        "stratum_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A_controlled_boundary_sweep",
            "B_center_nominal_level",
            "C_center_low_level",
            "D_silence",
            "E_impact_audio_video"
          ],
          "properties": {
            "A_controlled_boundary_sweep": {"const": 24},
            "B_center_nominal_level": {"const": 8},
            "C_center_low_level": {"const": 8},
            "D_silence": {"const": 3},
            "E_impact_audio_video": {"const": 4}
          }
        },
        "consumed_observations_reuse_forbidden": {"const": true},
        "post_hoc_threshold_or_scenario_change_forbidden": {"const": true}
      }
    },
    "preliminaryReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_before_final_protocol_freeze",
        "workflow_config_path",
        "workflow_config_sha256",
        "workflow_schema_path",
        "workflow_schema_sha256",
        "workflow_spec_path",
        "workflow_spec_sha256",
        "readiness_path",
        "required_take_count",
        "required_gate_count",
        "required_status",
        "diagnostic_results_are_official_evidence",
        "final_protocol_status"
      ],
      "properties": {
        "required_before_final_protocol_freeze": {"const": true},
        "workflow_config_path": {
          "const": "configs/s4_8_preliminary_workflow.v1.json"
        },
        "workflow_config_sha256": {"$ref": "#/$defs/sha256"},
        "workflow_schema_path": {
          "const": "docs/schemas/s4_8_preliminary_workflow.v1.schema.json"
        },
        "workflow_schema_sha256": {"$ref": "#/$defs/sha256"},
        "workflow_spec_path": {
          "const": "docs/development/specs/s4_8_preliminary_workflow.md"
        },
        "workflow_spec_sha256": {"$ref": "#/$defs/sha256"},
        "readiness_path": {
          "const": "runs/s4_8_preliminary/preliminary_readiness.v1.json"
        },
        "required_take_count": {"const": 4},
        "required_gate_count": {"const": 7},
        "required_status": {"const": "passed"},
        "diagnostic_results_are_official_evidence": {"const": false},
        "final_protocol_status": {"const": "not_frozen"}
      }
    },
    "unseenHoldout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdout_id",
        "status",
        "planned_take_id_prefix",
        "namespace_root",
        "observation_root",
        "precollection_seal_path",
        "partition_manifest_path",
        "session_manifest_path",
        "holdout_seal_path",
        "binding_path",
        "binding_schema_path",
        "consumed_observation_roots",
        "new_capture_required",
        "captured_after_preregistration_required",
        "observation_roots_must_be_disjoint",
        "holdout_must_remain_unopened_until_grant_consumption",
        "operator_acquisition_policy_path",
        "operator_acquisition_policy_sha256",
        "operator_acquisition_policy_schema_path",
        "operator_acquisition_policy_schema_sha256",
        "operator_acquisition_spec_path",
        "operator_acquisition_spec_sha256",
        "operator_authorization_required_per_take",
        "one_take_per_command",
        "automatic_batch_forbidden",
        "all_attempts_retained",
        "scientific_outcomes_must_remain_uninspected"
      ],
      "properties": {
        "holdout_id": {"const": "s4_8_recovery_amendment_02_unseen_holdout"},
        "status": {
          "const": "blocked_pending_preliminary_readiness_and_final_freeze"
        },
        "planned_take_id_prefix": {"const": "s48r02_unseen_holdout_"},
        "namespace_root": {"$ref": "#/$defs/path"},
        "observation_root": {"$ref": "#/$defs/path"},
        "precollection_seal_path": {"$ref": "#/$defs/path"},
        "partition_manifest_path": {"$ref": "#/$defs/path"},
        "session_manifest_path": {"$ref": "#/$defs/path"},
        "holdout_seal_path": {"$ref": "#/$defs/path"},
        "binding_path": {"$ref": "#/$defs/path"},
        "binding_schema_path": {"$ref": "#/$defs/path"},
        "consumed_observation_roots": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path"}
        },
        "new_capture_required": {"const": true},
        "captured_after_preregistration_required": {"const": true},
        "observation_roots_must_be_disjoint": {"const": true},
        "holdout_must_remain_unopened_until_grant_consumption": {"const": true},
        "operator_acquisition_policy_path": {
          "const": "configs/s4_8_operator_acquisition_policy.v1.json"
        },
        "operator_acquisition_policy_sha256": {"$ref": "#/$defs/sha256"},
        "operator_acquisition_policy_schema_path": {
          "const": "docs/schemas/s4_8_operator_acquisition_policy.v1.schema.json"
        },
        "operator_acquisition_policy_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "operator_acquisition_spec_path": {
          "const": "docs/development/specs/s4_8_operator_triggered_acquisition.md"
        },
        "operator_acquisition_spec_sha256": {"$ref": "#/$defs/sha256"},
        "operator_authorization_required_per_take": {"const": true},
        "one_take_per_command": {"const": true},
        "automatic_batch_forbidden": {"const": true},
        "all_attempts_retained": {"const": true},
        "scientific_outcomes_must_remain_uninspected": {"const": true}
      }
    },
    "futureAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id_template",
        "grant_path",
        "ledger_path",
        "journal_path",
        "derived_input_path",
        "output_path",
        "closeout_path",
        "independent_review_path",
        "new_holdout_binding_required",
        "independent_review_required",
        "new_explicit_authorization_required",
        "grant_creation_authorized",
        "grant_consumption_authorized",
        "evaluation_execution_authorized",
        "automatic_retry_of_prior_runs",
        "evaluation_implementation_status"
      ],
      "properties": {
        "grant_id_template": {"const": "s4_8_recovery_amendment_02_corrective_03_{source_commit}"},
        "grant_path": {"$ref": "#/$defs/path"},
        "ledger_path": {"$ref": "#/$defs/path"},
        "journal_path": {"$ref": "#/$defs/path"},
        "derived_input_path": {"$ref": "#/$defs/path"},
        "output_path": {"$ref": "#/$defs/path"},
        "closeout_path": {"$ref": "#/$defs/path"},
        "independent_review_path": {"$ref": "#/$defs/path"},
        "new_holdout_binding_required": {"const": true},
        "independent_review_required": {"const": true},
        "new_explicit_authorization_required": {"const": true},
        "grant_creation_authorized": {"const": false},
        "grant_consumption_authorized": {"const": false},
        "evaluation_execution_authorized": {"const": false},
        "automatic_retry_of_prior_runs": {"const": false},
        "evaluation_implementation_status": {
          "const": "blocked_until_preliminary_readiness_final_freeze_and_unseen_holdout_binding"
        }
      }
    }
  }
}
