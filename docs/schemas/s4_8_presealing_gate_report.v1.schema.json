{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ias/s4_8_presealing_gate_report.v1.schema.json",
  "title": "S4.8 pre-sealing gate report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision",
    "reasons",
    "dry_run",
    "authority",
    "decision_basis",
    "counts",
    "intervals",
    "metrics",
    "input_provenance",
    "detector_configuration",
    "detector_configuration_sha256",
    "configuration",
    "configuration_sha256",
    "detector"
  ],
  "properties": {
    "schema": {
      "const": "ias.s4_8.presealing_gate_report.v1"
    },
    "decision": {
      "enum": [
        "PASS",
        "RETRY_REQUIRED"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "category",
          "message",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "integrity",
              "playback_presence",
              "continuity",
              "coverage",
              "clipping",
              "channel_health"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "dry_run": {
      "type": "boolean"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creates_grant",
        "consumes_grant",
        "official_state_machine",
        "publishes_official_evidence",
        "seals_take"
      ],
      "properties": {
        "creates_grant": {
          "const": false
        },
        "consumes_grant": {
          "const": false
        },
        "official_state_machine": {
          "const": false
        },
        "publishes_official_evidence": {
          "const": false
        },
        "seals_take": {
          "const": false
        }
      }
    },
    "decision_basis": {
      "const": [
        "integrity",
        "playback_presence",
        "continuity",
        "coverage",
        "clipping",
        "channel_health"
      ]
    },
    "counts": {
      "type": "object"
    },
    "intervals": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "input_provenance": {
      "type": "object"
    },
    "detector_configuration": {
      "type": "object"
    },
    "detector_configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration": {
      "type": "object"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "detector": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
