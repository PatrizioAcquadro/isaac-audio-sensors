{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ias/s4_8_presealing_gate_report.v2.schema.json",
  "title": "S4.8 pre-sealing gate report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision",
    "reasons",
    "dry_run",
    "input_provenance",
    "authority",
    "configuration",
    "configuration_sha256",
    "detector_configuration_sha256",
    "capture_integrity",
    "waveform"
  ],
  "properties": {
    "schema": {
      "const": "ias.s4_8.presealing_gate_report.v2"
    },
    "decision": {
      "enum": [
        "PASS",
        "RETRY_REQUIRED"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "category",
          "message",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "integrity",
              "playback_presence",
              "continuity",
              "coverage",
              "clipping",
              "channel_health"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "dry_run": {
      "type": "boolean"
    },
    "input_provenance": {
      "type": "object",
      "required": [
        "capture_sha256",
        "reference_sha256",
        "manifest_sha256",
        "process_journal_head_sha256",
        "configuration_sha256",
        "detector_configuration_sha256",
        "outcome_fields_read"
      ]
    },
    "authority": {
      "const": {
        "creates_grant": false,
        "consumes_grant": false,
        "official_state_machine": false,
        "publishes_official_evidence": false,
        "official_take_seal": false
      }
    },
    "configuration": {
      "type": "object"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "detector_configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capture_integrity": {
      "type": "object"
    },
    "waveform": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
