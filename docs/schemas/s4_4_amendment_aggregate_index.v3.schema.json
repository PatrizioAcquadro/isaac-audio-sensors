{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_aggregate_index.v3.schema.json",
  "title": "S4.4 amendment-03 aggregate logical index v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","logical_counts","records","assignments_merged","access_histories_merged","blindness_claims_merged","fit_holdout_group_leakage","aggregate_index_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.aggregate_index.v3"},
    "status": {"const": "frozen_before_collection"},
    "logical_counts": {"const": {"inherited_fit_a":51,"new_fit_b":51,"new_prospective_holdout":47,"total":149}},
    "records": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "assignments_merged": {"const": false},
    "access_histories_merged": {"const": false},
    "blindness_claims_merged": {"const": false},
    "fit_holdout_group_leakage": {"const": false},
    "aggregate_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
