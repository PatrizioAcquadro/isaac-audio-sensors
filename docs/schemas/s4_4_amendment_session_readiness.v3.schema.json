{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_session_readiness.v3.schema.json",
  "title": "S4.4 amendment-03 reduced pre-attempt live readiness v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","amendment_id","session_id","session_date_local","collected_at_utc","precollection_seal_sha256","session_preflight_path","session_preflight_sha256","expected_next_attempt_id","checks","observations","attempt_allocated","recorder_started","playback_started","zed_capture_started","media_created","failure_retention_class","readiness_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_session_readiness.v3"},
    "status": {"enum": ["passed","failed"]},
    "amendment_id": {"const": "s4_4_data_expansion_amendment_03"},
    "session_id": {"enum": ["fit_b","prospective_holdout"]},
    "session_date_local": {"type": "string", "format": "date"},
    "collected_at_utc": {"type": "string", "format": "date-time"},
    "precollection_seal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "session_preflight_path": {"type": "string"},
    "session_preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_next_attempt_id": {"type": "string"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_permission_confirmed","mac_ssh_connectivity","mac_reduced_readiness_power_metadata","pi_ssh_connectivity","pi_helper_and_record_command_contract","respeaker_identity_device_format_channel_health_disk_and_output","zed_identity_and_readiness","clocks_and_truthful_session_timestamps","room_environment_mount_frame_origin_and_bounds","privacy","gitignore_and_output_paths","access_policy_and_ledger_state"],
      "properties": {
        "network_permission_confirmed": {"enum": ["passed","failed"]},
        "mac_ssh_connectivity": {"enum": ["passed","failed"]},
        "mac_reduced_readiness_power_metadata": {"enum": ["passed","failed"]},
        "pi_ssh_connectivity": {"enum": ["passed","failed"]},
        "pi_helper_and_record_command_contract": {"enum": ["passed","failed"]},
        "respeaker_identity_device_format_channel_health_disk_and_output": {"enum": ["passed","failed"]},
        "zed_identity_and_readiness": {"enum": ["passed","failed"]},
        "clocks_and_truthful_session_timestamps": {"enum": ["passed","failed"]},
        "room_environment_mount_frame_origin_and_bounds": {"enum": ["passed","failed"]},
        "privacy": {"enum": ["passed","failed"]},
        "gitignore_and_output_paths": {"enum": ["passed","failed"]},
        "access_policy_and_ledger_state": {"enum": ["passed","failed"]}
      }
    },
    "observations": {
      "type": "object",
      "required": ["mac_readiness"],
      "properties": {
        "mac_readiness": {
          "type": "object",
          "required": ["payload"],
          "properties": {
            "payload": {"$ref": "s4_4_amendment_mac_readiness.v1.schema.json"}
          }
        }
      }
    },
    "attempt_allocated": {"const": false},
    "recorder_started": {"const": false},
    "playback_started": {"const": false},
    "zed_capture_started": {"const": false},
    "media_created": {"const": false},
    "failure_retention_class": {"type": ["string","null"]},
    "readiness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
