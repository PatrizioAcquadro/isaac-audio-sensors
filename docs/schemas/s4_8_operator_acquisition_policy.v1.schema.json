{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/isaac-audio-sensors/s4_8_operator_acquisition_policy.v1.schema.json",
  "title": "S4.8 operator-triggered acquisition policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "specification_path",
    "applies_to",
    "policy",
    "authority"
  ],
  "properties": {
    "schema": {"const": "ias.s4_8.operator_acquisition_policy.v1"},
    "status": {"const": "active"},
    "specification_path": {
      "const": "docs/development/specs/s4_8_operator_triggered_acquisition.md"
    },
    "applies_to": {
      "const": [
        "s4_8_four_take_preliminary_v1",
        "s4_8_recovery_amendment_02_unseen_holdout"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_authorization_required_per_take",
        "one_take_per_command",
        "automatic_batch_forbidden",
        "all_attempts_retained",
        "technical_retry_attempt_limit",
        "technical_retry_requires_retained_retry_required",
        "attempt_numbers_strictly_monotonic",
        "sequence_advances_only_after_pass",
        "passed_take_replacement_requires_versioned_invalidation",
        "scientific_outcomes_must_remain_uninspected"
      ],
      "properties": {
        "operator_authorization_required_per_take": {"const": true},
        "one_take_per_command": {"const": true},
        "automatic_batch_forbidden": {"const": true},
        "all_attempts_retained": {"const": true},
        "technical_retry_attempt_limit": {"type": "null"},
        "technical_retry_requires_retained_retry_required": {"const": true},
        "attempt_numbers_strictly_monotonic": {"const": true},
        "sequence_advances_only_after_pass": {"const": true},
        "passed_take_replacement_requires_versioned_invalidation": {
          "const": true
        },
        "scientific_outcomes_must_remain_uninspected": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creates_grant",
        "consumes_grant",
        "opens_holdout",
        "official_state_machine",
        "publishes_official_evidence",
        "freezes_final_protocol",
        "starts_official_acquisition"
      ],
      "properties": {
        "creates_grant": {"const": false},
        "consumes_grant": {"const": false},
        "opens_holdout": {"const": false},
        "official_state_machine": {"const": false},
        "publishes_official_evidence": {"const": false},
        "freezes_final_protocol": {"const": false},
        "starts_official_acquisition": {"const": false}
      }
    }
  }
}
