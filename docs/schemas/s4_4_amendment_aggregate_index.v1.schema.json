{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_aggregate_index.v1.schema.json",
  "title": "S4.4 aggregate legacy/amendment index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","records","assignments_merged","access_histories_merged","blindness_claims_merged","original_assignment_changed","aggregate_index_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.aggregate_index.v1"},
    "status": {"const": "frozen_before_collection"},
    "records": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "assignments_merged": {"const": false},
    "access_histories_merged": {"const": false},
    "blindness_claims_merged": {"const": false},
    "original_assignment_changed": {"const": false},
    "aggregate_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
