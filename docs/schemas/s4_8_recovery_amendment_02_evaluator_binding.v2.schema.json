{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isaac-audio-sensors.local/schemas/s4_8_recovery_amendment_02_evaluator_binding.v2.schema.json",
  "title": "S4.8 recovery amendment-02 37-take evaluator binding v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "binding_id",
    "amendment_id",
    "revision_id",
    "holdout_id",
    "evaluator",
    "protocol",
    "bindings",
    "sealed_state",
    "authority"
  ],
  "properties": {
    "schema": {"const": "ias.s4_8.recovery_02_evaluator_binding.v2"},
    "status": {"const": "frozen"},
    "binding_id": {"const": "s4_8_recovery_amendment_02_37_take_evaluator_binding"},
    "amendment_id": {"const": "s4_8_recovery_amendment_02"},
    "revision_id": {"const": "s4_8_recovery_amendment_02_preholdout_37_take_revision"},
    "holdout_id": {"const": "s4_8_recovery_amendment_02_unseen_holdout"},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "tool_version",
        "payload_schema",
        "result_schema",
        "source_commit",
        "source_files"
      ],
      "properties": {
        "entrypoint": {"const": "isaac_audio_sensors.acquisition.s4_8_recovery_02_evaluator:evaluate_payload"},
        "tool_version": {"const": "ias_s4_8_recovery_02_evaluator/1.0.1"},
        "payload_schema": {"const": "ias.s4_8.recovery_02.corrective_metrics.v1"},
        "result_schema": {"const": "ias.s4_8.recovery_02.criteria_evaluation_result.v2"},
        "source_commit": {"const": "b6703ee1601826f8a5d96b6d69345edfd252e577"},
        "source_files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/fileBinding"}
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_sha256",
        "planned_take_count",
        "leakage_group_count",
        "planned_take_ids_sha256",
        "stratum_counts",
        "primary_metric",
        "primary_threshold",
        "primary_denominator",
        "take_aggregation",
        "inherited_criterion_count",
        "effective_gating_criterion_count",
        "continuous_bearing_diagnostic_criteria",
        "superseded_sector_criteria",
        "comparison_expected_counts",
        "gating_comparison_ids"
      ],
      "properties": {
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "planned_take_count": {"const": 37},
        "leakage_group_count": {"const": 15},
        "planned_take_ids_sha256": {"$ref": "#/$defs/sha256"},
        "stratum_counts": {
          "const": {
            "A_controlled_boundary_sweep": 24,
            "B_center_nominal_level": 4,
            "C_center_low_level": 4,
            "D_silence": 3,
            "E_impact_audio_video": 2
          }
        },
        "primary_metric": {"const": "squadbot_categorical_direction_accuracy"},
        "primary_threshold": {"const": 0.75},
        "primary_denominator": {"const": 28},
        "take_aggregation": {
          "const": {
            "representative_bearing_field": "estimated_bearing_deg_f_project",
            "representative_bearing_derivation": "linear_median_of_valid_exact_window_bearings",
            "mapping_application": "once_per_take_to_representative_bearing",
            "no_valid_bearing_result": "unavailable",
            "failed_or_missing_take_result": "adverse",
            "active_unavailable_result": "incorrect",
            "rear_unavailable_result": "correct_only_when_take_not_failed",
            "silence_unavailable_result": "correct_only_when_take_not_failed"
          }
        },
        "inherited_criterion_count": {"const": 29},
        "effective_gating_criterion_count": {"const": 17},
        "continuous_bearing_diagnostic_criteria": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "superseded_sector_criteria": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "comparison_expected_counts": {
          "const": {
            "abstention_abd": 31,
            "bearing_doa_error_ab": 28,
            "candidate_bearing_ab": 28,
            "coarse_audio_video_association_e": 2,
            "confidence_bc": 8,
            "sector_accuracy_b": 4,
            "tdoa_a": 144
          }
        },
        "gating_comparison_ids": {
          "const": [
            "abstention_abd",
            "candidate_bearing_ab",
            "coarse_audio_video_association_e",
            "confidence_bc",
            "tdoa_a"
          ]
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_manifest",
        "denominators",
        "criteria_register",
        "partition_manifest",
        "session_manifest",
        "precollection_seal",
        "holdout_seal",
        "holdout_binding"
      ],
      "properties": {
        "design_manifest": {"$ref": "#/$defs/fileBinding"},
        "denominators": {"$ref": "#/$defs/fileBinding"},
        "criteria_register": {"$ref": "#/$defs/fileBinding"},
        "partition_manifest": {"$ref": "#/$defs/fileBinding"},
        "session_manifest": {"$ref": "#/$defs/fileBinding"},
        "precollection_seal": {"$ref": "#/$defs/payloadBinding"},
        "holdout_seal": {"$ref": "#/$defs/payloadBinding"},
        "holdout_binding": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "sealed_state": {
      "const": {
        "technically_sealed": true,
        "scientifically_opened": false,
        "scientific_artifact_contents_parsed": false,
        "scientific_outcomes_derived": false,
        "scientific_outputs_returned": false
      }
    },
    "authority": {
      "const": {
        "adds_independent_review": false,
        "creates_grant": false,
        "consumes_grant": false,
        "opens_holdout": false,
        "runs_evaluation": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "payloadBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "payload_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
