{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ias/s4_8_presealing_gate_config.v1.schema.json",
  "title": "S4.8 pre-sealing gate configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sample_rate_hz",
    "channel_count",
    "microphone_channel_indices",
    "capture_duration_s",
    "capture_duration_tolerance_s",
    "playback_start_s",
    "playback_start_tolerance_s",
    "playback_stop_s",
    "evaluation_start_s",
    "evaluation_stop_s",
    "minimum_useful_sound_coverage",
    "minimum_continuous_useful_s",
    "maximum_non_applicable_gap_s",
    "maximum_clip_run_samples",
    "maximum_channel_rms_spread_db",
    "maximum_negative_reference_correlation",
    "detector"
  ],
  "properties": {
    "schema": {
      "const": "ias.s4_8.presealing_gate_config.v1"
    },
    "sample_rate_hz": {
      "const": 16000
    },
    "channel_count": {
      "const": 6
    },
    "microphone_channel_indices": {
      "const": [
        2,
        3,
        4,
        5
      ]
    },
    "capture_duration_s": {
      "const": 20.0
    },
    "capture_duration_tolerance_s": {
      "const": 0.05
    },
    "playback_start_s": {
      "const": 1.0
    },
    "playback_start_tolerance_s": {
      "const": 0.1
    },
    "playback_stop_s": {
      "const": 19.0
    },
    "evaluation_start_s": {
      "const": 1.25
    },
    "evaluation_stop_s": {
      "const": 18.75
    },
    "minimum_useful_sound_coverage": {
      "const": 0.9
    },
    "minimum_continuous_useful_s": {
      "const": 16.0
    },
    "maximum_non_applicable_gap_s": {
      "const": 0.5
    },
    "maximum_clip_run_samples": {
      "const": 8
    },
    "maximum_channel_rms_spread_db": {
      "const": 6.0
    },
    "maximum_negative_reference_correlation": {
      "const": -0.2
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_block_samples",
        "basic_rms_floor",
        "background_normalized_mad_scale",
        "background_mad_multiplier",
        "minimum_reference_correlation",
        "minimum_pair_coherence",
        "minimum_correlated_channel_count",
        "maximum_reference_lag_samples",
        "minimum_detection_contiguous_blocks"
      ],
      "properties": {
        "analysis_block_samples": {
          "const": 2000
        },
        "basic_rms_floor": {
          "const": 0.002
        },
        "background_normalized_mad_scale": {
          "const": 1.4826
        },
        "background_mad_multiplier": {
          "const": 5.0
        },
        "minimum_reference_correlation": {
          "const": 0.2
        },
        "minimum_pair_coherence": {
          "const": 0.1
        },
        "minimum_correlated_channel_count": {
          "const": 3
        },
        "maximum_reference_lag_samples": {
          "const": 16
        },
        "minimum_detection_contiguous_blocks": {
          "const": 8
        }
      }
    }
  }
}
