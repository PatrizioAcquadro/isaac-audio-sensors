      "properties": {
        "grant_id_template": {"type": "string", "minLength": 1},
        "grant_path": {"$ref": "#/$defs/path"},
        "ledger_path": {"$ref": "#/$defs/path"},
        "journal_path": {"$ref": "#/$defs/path"},
        "derived_input_path": {"$ref": "#/$defs/path"},
