        "independent_review_path",
        "new_holdout_binding_required",
        "independent_review_required",
        "new_explicit_authorization_required",
        "grant_creation_authorized",
        "grant_consumption_authorized",
        "evaluation_execution_authorized",
        "automatic_retry_of_prior_runs",
        "evaluation_implementation_status"
