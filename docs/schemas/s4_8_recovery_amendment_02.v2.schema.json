        "design_schema_path": {"$ref": "#/$defs/path"},
        "design_schema_sha256": {"$ref": "#/$defs/sha256"},
        "denominators_path": {"$ref": "#/$defs/path"},
        "denominators_sha256": {"$ref": "#/$defs/sha256"},
