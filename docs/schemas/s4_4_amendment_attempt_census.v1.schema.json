{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_attempt_census.v1.schema.json",
  "title": "S4.4 amendment attempt census v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","planned_takes","attempts","valid_takes","failures","replacements","incomplete_planned_cells","all_attempts_retained","second_failure_present","census_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_attempt_census.v1"},
    "status": {"enum": ["incomplete","no_go","passed"]},
    "planned_takes": {"const": 149},
    "attempts": {"type": "integer", "minimum": 0, "maximum": 298},
    "valid_takes": {"type": "integer", "minimum": 0, "maximum": 149},
    "failures": {"type": "integer", "minimum": 0, "maximum": 298},
    "replacements": {"type": "integer", "minimum": 0, "maximum": 149},
    "incomplete_planned_cells": {"type": "integer", "minimum": 0, "maximum": 149},
    "all_attempts_retained": {"const": true},
    "second_failure_present": {"type": "boolean"},
    "census_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
