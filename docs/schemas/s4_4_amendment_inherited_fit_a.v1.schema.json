{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_inherited_fit_a.v1.schema.json",
  "title": "S4.4 amendment-03 inherited amendment-02 Fit A record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","source_amendment_id","session_id","session_manifest","preflight","readiness","census","logical_cells","file_inventory","file_inventory_sha256","file_inventory_sha256sum_tree","failed_attempt_id","replacement_attempt_id","failed_and_replacement_attempts_retained","replacement_allowance_reset","additional_attempts_allowed_for_inherited_cells","scientific_outcomes_inspected","inherited_fit_a_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_03_inherited_fit_a.v1"},
    "status": {"const": "complete_immutable_inheritance"},
    "source_amendment_id": {"const": "s4_4_data_expansion_amendment_02"},
    "session_id": {"const": "fit_a"},
    "session_manifest": {"type": "object"},
    "preflight": {"type": "object"},
    "readiness": {"type": "object"},
    "census": {"type": "object"},
    "logical_cells": {"type": "array", "minItems": 51, "maxItems": 51, "items": {"type": "object"}},
    "file_inventory": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "file_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_inventory_sha256sum_tree": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "failed_attempt_id": {"type": "string", "minLength": 1},
    "replacement_attempt_id": {"type": "string", "minLength": 1},
    "failed_and_replacement_attempts_retained": {"const": true},
    "replacement_allowance_reset": {"const": false},
    "additional_attempts_allowed_for_inherited_cells": {"const": 0},
    "scientific_outcomes_inspected": {"const": false},
    "inherited_fit_a_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
