{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "additive_only": {
          "const": true
        },
        "changes_prior_phase_artifacts": {
          "const": false
        },
        "holdout_opening_belongs_to": {
          "const": "S4.8"
        },
        "implements_holdout_opening_workflow": {
          "const": false
        },
        "interlock_artifact_schema": {
          "const": "ias.s4_7.holdout_acceptance.v1"
        },
        "interlock_consumer": {
          "const": "isaac_audio_sensors.acquisition.s4_4.consume_s4_8_grant"
        },
        "opens_holdout_observations": {
          "const": false
        }
      },
      "required": [
        "additive_only",
        "changes_prior_phase_artifacts",
        "opens_holdout_observations",
        "implements_holdout_opening_workflow",
        "holdout_opening_belongs_to",
        "interlock_artifact_schema",
        "interlock_consumer"
      ],
      "type": "object"
    },
    "baseline_branch": {
      "type": "string"
    },
    "baseline_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "criteria": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "comparator": {
            "enum": [
              "less_than_or_equal",
              "greater_than_or_equal",
              "equal"
            ]
          },
          "criterion_id": {
            "pattern": "^[a-z0-9_]+$",
            "type": "string"
          },
          "decision_rationale": {
            "minLength": 1,
            "type": "string"
          },
          "denominator": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "basis": {
                    "enum": [
                      "takes",
                      "planned_takes",
                      "analysis_windows",
                      "bearing_cells",
                      "bearing_cell_pair_groups",
                      "raw_channel_take_records",
                      "compared_gating_metrics"
                    ]
                  },
                  "expected_count": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                },
                "required": [
                  "basis",
                  "expected_count"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_logic": {
            "minLength": 1,
            "type": "string"
          },
          "gating": {
            "type": "boolean"
          },
          "metric": {
            "type": "string"
          },
          "metric_contract": {
            "additionalProperties": false,
            "properties": {
              "aggregation": {
                "minLength": 1,
                "type": "string"
              },
              "applicability": {
                "minLength": 1,
                "type": "string"
              },
              "exclusions": {
                "minLength": 1,
                "type": "string"
              },
              "limitations": {
                "minLength": 1,
                "type": "string"
              },
              "method": {
                "minLength": 1,
                "type": "string"
              },
              "missing": {
                "minLength": 1,
                "type": "string"
              },
              "reference": {
                "minLength": 1,
                "type": "string"
              },
              "uncertainty": {
                "minLength": 1,
                "type": "string"
              },
              "units": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "method",
              "reference",
              "units",
              "uncertainty",
              "aggregation",
              "exclusions",
              "missing",
              "applicability",
              "limitations"
            ],
            "type": "object"
          },
          "observable": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            ]
          },
          "sample_kind": {
            "enum": [
              "series",
              "paired_series",
              "grouped_series",
              "counter",
              "scalar",
              "comparison_set"
            ]
          },
          "statistic": {
            "enum": [
              "median",
              "p95_nearest_rank",
              "worst",
              "range",
              "identity",
              "rate",
              "max_group_range",
              "max_group_circular_range",
              "median_difference",
              "absolute_median_difference",
              "worsened_gating_metric_count"
            ]
          },
          "strata": {
            "items": {
              "enum": [
                "A_controlled_boundary_sweep",
                "B_center_nominal_level",
                "C_center_low_level",
                "D_silence",
                "E_impact_audio_video",
                "all"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "threshold": {
            "type": "number"
          },
          "tier": {
            "enum": [
              "readiness",
              "stretch"
            ]
          }
        },
        "required": [
          "criterion_id",
          "metric",
          "strata",
          "tier",
          "gating",
          "observable",
          "sample_kind",
          "statistic",
          "comparator",
          "threshold",
          "denominator",
          "decision_rationale",
          "failure_logic",
          "metric_contract"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "envelope": {
      "additionalProperties": false,
      "properties": {
        "claimed_envelope": {
          "const": "controlled_source_single_room_single_mount"
        },
        "controlled_versus_robustness": {
          "minLength": 1,
          "type": "string"
        },
        "coordinate_convention": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "mount_fixture_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "playback_gains": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "raw_channel_order": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "room_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "sample_rate_hz": {
          "minimum": 1,
          "type": "integer"
        },
        "source_devices": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "source_frame": {
          "type": "string"
        },
        "take_duration_s": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "target_radius_m": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "claimed_envelope",
        "room_ids",
        "mount_fixture_ids",
        "device_id",
        "source_devices",
        "source_frame",
        "coordinate_convention",
        "sample_rate_hz",
        "raw_channel_order",
        "target_radius_m",
        "playback_gains",
        "take_duration_s",
        "controlled_versus_robustness"
      ],
      "type": "object"
    },
    "failure_logic": {
      "additionalProperties": false,
      "properties": {
        "narrower_envelope_rule": {
          "minLength": 1,
          "type": "string"
        },
        "on_failure": {
          "minLength": 1,
          "type": "string"
        },
        "prohibited_after_freeze": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "readiness_pass_rule": {
          "minLength": 1,
          "type": "string"
        },
        "stretch_rule": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "readiness_pass_rule",
        "stretch_rule",
        "on_failure",
        "prohibited_after_freeze",
        "narrower_envelope_rule"
      ],
      "type": "object"
    },
    "frozen_at_utc": {
      "type": "string"
    },
    "holdout_binding": {
      "additionalProperties": false,
      "properties": {
        "bound_holdout_id": {
          "const": "s4_4_data_expansion_amendment_03_prospective_holdout"
        },
        "excluded_historical_holdout": {
          "additionalProperties": false,
          "properties": {
            "gating_power": {
              "const": "none"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "retained_as": {
              "const": "archived_diagnostic_evidence"
            },
            "seal_file_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "seal_path": {
              "type": "string"
            }
          },
          "required": [
            "seal_path",
            "seal_file_sha256",
            "reason",
            "gating_power",
            "retained_as"
          ],
          "type": "object"
        },
        "group_count": {
          "const": 15
        },
        "partition_manifest_path": {
          "type": "string"
        },
        "partition_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "planned_take_count": {
          "const": 47
        },
        "scientifically_opened": {
          "const": false
        },
        "seal_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "seal_path": {
          "type": "string"
        },
        "seal_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "seal_schema": {
          "const": "ias.s4_4.amendment_holdout_seal.v1"
        },
        "session_manifest_path": {
          "type": "string"
        },
        "session_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "technical_qa_only": {
          "const": true
        }
      },
      "required": [
        "bound_holdout_id",
        "seal_path",
        "seal_file_sha256",
        "seal_payload_sha256",
        "seal_schema",
        "partition_manifest_path",
        "partition_manifest_sha256",
        "session_manifest_path",
        "session_manifest_sha256",
        "planned_take_count",
        "group_count",
        "scientifically_opened",
        "technical_qa_only",
        "excluded_historical_holdout"
      ],
      "type": "object"
    },
    "missing_and_unsupported_treatment": {
      "additionalProperties": false,
      "properties": {
        "denominator_mismatch": {
          "const": "fail_closed_criterion_failure"
        },
        "extra_observable": {
          "const": "fail_closed_configuration_error"
        },
        "missing_observable": {
          "const": "fail_closed_criterion_failure"
        },
        "non_finite_value": {
          "const": "fail_closed_criterion_failure"
        },
        "not_evaluable_condition": {
          "const": "reported_as_not_evaluable_never_as_pass"
        },
        "rationale": {
          "minLength": 1,
          "type": "string"
        },
        "unsupported_quantity": {
          "const": "never_thresholded_and_never_claimed"
        }
      },
      "required": [
        "missing_observable",
        "extra_observable",
        "non_finite_value",
        "denominator_mismatch",
        "unsupported_quantity",
        "not_evaluable_condition",
        "rationale"
      ],
      "type": "object"
    },
    "not_evaluable": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "declaration": {
          "minLength": 1,
          "type": "string"
        },
        "future_requirement": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "declaration",
        "conditions",
        "future_requirement"
      ],
      "type": "object"
    },
    "phase": {
      "const": "S4.7"
    },
    "phase_boundary": {
      "additionalProperties": false,
      "properties": {
        "allowed_claim": {
          "minLength": 1,
          "type": "string"
        },
        "classifications": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "holdout_access_grant_created": {
          "const": false
        },
        "holdout_observations_accessed": {
          "const": 0
        },
        "s4_8_started": {
          "const": false
        },
        "s4_9_started": {
          "const": false
        },
        "s5_started": {
          "const": false
        }
      },
      "required": [
        "s4_8_started",
        "s4_9_started",
        "s5_started",
        "holdout_observations_accessed",
        "holdout_access_grant_created",
        "allowed_claim",
        "classifications"
      ],
      "type": "object"
    },
    "schema": {
      "const": "ias.s4_7.holdout_acceptance_config.v1"
    },
    "sim_vs_real": {
      "additionalProperties": false,
      "properties": {
        "adjusted_simulation_definition": {
          "minLength": 1,
          "type": "string"
        },
        "classification": {
          "const": [
            "improves",
            "preserves",
            "worsens"
          ]
        },
        "classification_rule": {
          "minLength": 1,
          "type": "string"
        },
        "gating_metric_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "harness_status": {
          "minLength": 1,
          "type": "string"
        },
        "paths": {
          "const": [
            "real",
            "unadjusted_simulation",
            "adjusted_simulation"
          ]
        },
        "preserve_bands": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minProperties": 1,
          "type": "object"
        },
        "reporting_requirement": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "paths",
        "adjusted_simulation_definition",
        "classification",
        "classification_rule",
        "preserve_bands",
        "gating_metric_ids",
        "reporting_requirement",
        "harness_status"
      ],
      "type": "object"
    },
    "spec_path": {
      "const": "docs/development/specs/s4_holdout_acceptance.md"
    },
    "statistics": {
      "type": "object"
    },
    "status": {
      "const": "frozen"
    },
    "strata": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bearing_cell_count": {
            "minimum": 0,
            "type": "integer"
          },
          "bearing_reference_available": {
            "type": "boolean"
          },
          "category": {
            "enum": [
              "controlled",
              "confidence",
              "silence",
              "audio_video"
            ]
          },
          "note": {
            "minLength": 1,
            "type": "string"
          },
          "playback_gain": {
            "type": [
              "number",
              "null"
            ]
          },
          "repetitions_per_bearing": {
            "type": [
              "integer",
              "null"
            ]
          },
          "sector_accuracy_gated": {
            "type": "boolean"
          },
          "sector_geometry": {
            "enum": [
              "sector_center",
              "sector_boundary",
              "not_applicable"
            ]
          },
          "stratum_id": {
            "enum": [
              "A_controlled_boundary_sweep",
              "B_center_nominal_level",
              "C_center_low_level",
              "D_silence",
              "E_impact_audio_video"
            ]
          },
          "take_count": {
            "minimum": 1,
            "type": "integer"
          },
          "target_bearings_deg_f_project": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "uniqueItems": true
          },
          "target_radius_m": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "stratum_id",
          "category",
          "take_count",
          "target_bearings_deg_f_project",
          "repetitions_per_bearing",
          "bearing_cell_count",
          "playback_gain",
          "target_radius_m",
          "sector_geometry",
          "bearing_reference_available",
          "sector_accuracy_gated",
          "note"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "unsupported_quantities": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "status",
    "title",
    "phase",
    "frozen_at_utc",
    "baseline_branch",
    "baseline_commit",
    "spec_path",
    "authority",
    "holdout_binding",
    "envelope",
    "strata",
    "statistics",
    "sim_vs_real",
    "not_evaluable",
    "unsupported_quantities",
    "missing_and_unsupported_treatment",
    "failure_logic",
    "phase_boundary",
    "criteria"
  ],
  "title": "S4.7 holdout acceptance preregistration configuration",
  "type": "object"
}
