{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_technical_qa.v2.schema.json",
  "title": "S4.4 prospective-holdout technical QA canonical projection v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","source_schema","partition","planned_take_id","attempt_id","identity_pass","assigned_metadata_declaration_carried_forward","duration_pass","six_channel_count_pass","no_detected_silent_channel_issue","clipping_pass","producer_timestamps_present","playback_record_present_or_not_required","integrity_pass","privacy_declaration_carried_forward","full_svo2_replay_pass","overall_technical_pass","scientific_outputs_exposed","suppressed_field_count"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_technical_qa.v2"},
    "source_schema": {"type": "string"},
    "partition": {"const": "prospective_holdout"},
    "planned_take_id": {"type": "string", "pattern": "^s44a0[13]_prospective_holdout_"},
    "attempt_id": {"type": "string"},
    "identity_pass": {"type": "boolean"},
    "assigned_metadata_declaration_carried_forward": {"type": "boolean"},
    "duration_pass": {"type": "boolean"},
    "six_channel_count_pass": {"type": "boolean"},
    "no_detected_silent_channel_issue": {"type": "boolean"},
    "clipping_pass": {"type": "boolean"},
    "producer_timestamps_present": {"type": "boolean"},
    "playback_record_present_or_not_required": {"type": "boolean"},
    "integrity_pass": {"type": "boolean"},
    "privacy_declaration_carried_forward": {"type": "boolean"},
    "full_svo2_replay_pass": {"type": "boolean"},
    "overall_technical_pass": {"type": "boolean"},
    "scientific_outputs_exposed": {"const": false},
    "suppressed_field_count": {"type": "integer", "minimum": 0}
  }
}
