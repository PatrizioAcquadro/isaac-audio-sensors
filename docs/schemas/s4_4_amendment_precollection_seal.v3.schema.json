{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_precollection_seal.v3.schema.json",
  "title": "S4.4 amendment-03 precollection seal v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","amendment_id","bindings","source_checkpoint","collection_allowed","capture_prohibited_until_committed_and_sealed","holdout_scientifically_opened","s4_5_or_later_started","seal_payload_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_precollection_seal.v3"},
    "status": {"enum": ["awaiting_commit_authorization","committed"]},
    "amendment_id": {"const": "s4_4_data_expansion_amendment_03"},
    "bindings": {"type": "object", "minProperties": 12, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "source_checkpoint": {"type": ["object","null"]},
    "collection_allowed": {"type": "boolean"},
    "capture_prohibited_until_committed_and_sealed": {"const": true},
    "holdout_scientifically_opened": {"const": false},
    "s4_5_or_later_started": {"const": false},
    "seal_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
