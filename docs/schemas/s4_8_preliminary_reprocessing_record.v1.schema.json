{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/isaac-audio-sensors/s4_8_preliminary_reprocessing_record.v1.schema.json",
  "title": "S4.8 preliminary additive correction and reprocessing record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "correction_id",
    "change_class",
    "case_id",
    "preliminary_take_id",
    "attempt_number",
    "attempt_path",
    "historical_result",
    "corrected_offline_result",
    "reuse_decision",
    "classification",
    "authority",
    "record_sha256"
  ],
  "properties": {
    "schema": {
      "const": "ias.s4_8.preliminary_reprocessing_record.v1"
    },
    "correction_id": {
      "type": "string",
      "minLength": 1
    },
    "change_class": {
      "const": "detector_or_processing"
    },
    "case_id": {
      "enum": [
        "nominal_reference",
        "low_level_reference",
        "silence",
        "audio_video_impact_with_zed"
      ]
    },
    "preliminary_take_id": {
      "type": "string",
      "pattern": "^s48prelim_"
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_path": {
      "$ref": "#/$defs/absolutePath"
    },
    "historical_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "raw_capture",
        "retry_report",
        "gate_report",
        "controller_result",
        "process_journal",
        "take_precollection_manifest",
        "attempt_ledger",
        "campaign_manifest",
        "journal_gate_decision",
        "ledger_gate_decision"
      ],
      "properties": {
        "decision": {
          "const": "RETRY_REQUIRED"
        },
        "raw_capture": {
          "$ref": "#/$defs/artifact"
        },
        "retry_report": {
          "$ref": "#/$defs/artifact"
        },
        "gate_report": {
          "$ref": "#/$defs/artifact"
        },
        "controller_result": {
          "$ref": "#/$defs/artifact"
        },
        "process_journal": {
          "$ref": "#/$defs/artifact"
        },
        "take_precollection_manifest": {
          "$ref": "#/$defs/artifact"
        },
        "attempt_ledger": {
          "$ref": "#/$defs/artifact"
        },
        "campaign_manifest": {
          "$ref": "#/$defs/artifact"
        },
        "journal_gate_decision": {
          "const": "RETRY_REQUIRED"
        },
        "ledger_gate_decision": {
          "const": "RETRY_REQUIRED"
        }
      }
    },
    "corrected_offline_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "report",
        "report_canonical_sha256",
        "corrective_commit",
        "useful_block_count",
        "source_block_count",
        "useful_sound_coverage",
        "continuous_useful_duration_s",
        "maximum_non_applicable_gap_s"
      ],
      "properties": {
        "decision": {
          "const": "PASS"
        },
        "report": {
          "$ref": "#/$defs/artifact"
        },
        "report_canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "corrective_commit": {
          "$ref": "#/$defs/commit"
        },
        "useful_block_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_block_count": {
          "type": "integer",
          "minimum": 1
        },
        "useful_sound_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "continuous_useful_duration_s": {
          "type": "number",
          "minimum": 0
        },
        "maximum_non_applicable_gap_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "reuse_decision": {
      "$ref": "#/$defs/reuseDecision"
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/absolutePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reuseDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "correction_id",
        "change_class",
        "affected_case_ids",
        "raw_sha256_by_case",
        "decision",
        "technical_justification",
        "physical_confirmation",
        "physical_confirmation_evidence",
        "replacement_complete",
        "automatic_four_take_reacquisition",
        "classification",
        "authority",
        "decision_sha256"
      ],
      "properties": {
        "schema": {
          "const": "ias.s4_8.preliminary_reuse_decision.v1"
        },
        "correction_id": {
          "type": "string",
          "minLength": 1
        },
        "change_class": {
          "const": "detector_or_processing"
        },
        "affected_case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "raw_sha256_by_case": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "decision": {
          "const": "reuse"
        },
        "technical_justification": {
          "type": "string",
          "minLength": 1
        },
        "physical_confirmation": {
          "const": "not_required_by_evidence"
        },
        "physical_confirmation_evidence": {
          "type": "string",
          "minLength": 1
        },
        "replacement_complete": {
          "const": false
        },
        "automatic_four_take_reacquisition": {
          "const": false
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "decision_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineering_only",
        "uncounted",
        "excluded_from_official_holdout",
        "safe_to_inspect_and_analyze",
        "diagnostic_results_only",
        "official_evidence_eligible"
      ],
      "properties": {
        "engineering_only": {
          "const": true
        },
        "uncounted": {
          "const": true
        },
        "excluded_from_official_holdout": {
          "const": true
        },
        "safe_to_inspect_and_analyze": {
          "const": true
        },
        "diagnostic_results_only": {
          "const": true
        },
        "official_evidence_eligible": {
          "const": false
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creates_grant",
        "consumes_grant",
        "opens_holdout",
        "official_state_machine",
        "publishes_official_evidence",
        "freezes_final_protocol",
        "starts_official_acquisition"
      ],
      "properties": {
        "creates_grant": {
          "const": false
        },
        "consumes_grant": {
          "const": false
        },
        "opens_holdout": {
          "const": false
        },
        "official_state_machine": {
          "const": false
        },
        "publishes_official_evidence": {
          "const": false
        },
        "freezes_final_protocol": {
          "const": false
        },
        "starts_official_acquisition": {
          "const": false
        }
      }
    }
  }
}
