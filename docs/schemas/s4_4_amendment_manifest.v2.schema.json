{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_manifest.v2.schema.json",
  "title": "S4.4 data-expansion amendment-02 session manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","amendment_id","partition","session_id","session_date_local","calendar_day_role","planned_take_count","takes","manifest_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.data_expansion_manifest.v2"},
    "status": {"const": "frozen_before_collection"},
    "amendment_id": {"const": "s4_4_data_expansion_amendment_02"},
    "partition": {"enum": ["fit","prospective_holdout"]},
    "session_id": {"enum": ["fit_a","fit_b","prospective_holdout"]},
    "session_date_local": {"type": "null"},
    "calendar_day_role": {"enum": ["distinct_day_1","distinct_day_2","distinct_day_3"]},
    "planned_take_count": {"enum": [47,51]},
    "takes": {"type": "array", "minItems": 47, "maxItems": 51, "items": {"$ref": "#/$defs/take"}},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "take": {
      "type": "object",
      "required": ["planned_take_id","sequence_index","partition","session_id","category","duration_s","group_id","take_definition_sha256","expected_artifact_paths","predecessor_planned_take_id","successor_planned_take_id"],
      "properties": {
        "planned_take_id": {"type": "string", "pattern": "^s44a02_"},
        "sequence_index": {"type": "integer", "minimum": 1, "maximum": 51},
        "partition": {"enum": ["fit","prospective_holdout"]},
        "session_id": {"enum": ["fit_a","fit_b","prospective_holdout"]},
        "category": {"enum": ["controlled","confidence","silence","audio_video"]},
        "duration_s": {"enum": [15,20]},
        "group_id": {"type": "string", "pattern": "^s44a02_grp_[0-9a-f]{20}$"},
        "take_definition_sha256": {"$ref": "#/$defs/sha256"},
        "expected_artifact_paths": {"type": "object"},
        "predecessor_planned_take_id": {"type": ["string","null"]},
        "successor_planned_take_id": {"type": ["string","null"]}
      }
    }
  }
}
