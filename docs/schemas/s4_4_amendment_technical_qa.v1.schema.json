{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_technical_qa.v1.schema.json",
  "title": "S4.4 prospective-holdout technical QA v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","partition","planned_take_id","attempt_id","identity_pass","assigned_metadata_pass","duration_pass","channel_order_pass","channel_health_pass","clipping_pass","timestamps_pass","reference_presence_pass","integrity_pass","privacy_pass","full_svo2_replay_pass","overall_technical_pass","scientific_outputs_exposed","suppressed_field_count"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_technical_qa.v1"},
    "partition": {"const": "prospective_holdout"},
    "planned_take_id": {"type": "string", "pattern": "^s44a01_prospective_holdout_"},
    "attempt_id": {"type": "string"},
    "identity_pass": {"type": "boolean"},
    "assigned_metadata_pass": {"type": "boolean"},
    "duration_pass": {"type": "boolean"},
    "channel_order_pass": {"type": "boolean"},
    "channel_health_pass": {"type": "boolean"},
    "clipping_pass": {"type": "boolean"},
    "timestamps_pass": {"type": "boolean"},
    "reference_presence_pass": {"type": "boolean"},
    "integrity_pass": {"type": "boolean"},
    "privacy_pass": {"type": "boolean"},
    "full_svo2_replay_pass": {"type": "boolean"},
    "overall_technical_pass": {"type": "boolean"},
    "scientific_outputs_exposed": {"const": false},
    "suppressed_field_count": {"type": "integer", "minimum": 0}
  }
}
