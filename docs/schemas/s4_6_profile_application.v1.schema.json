{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_pointer_path": {
      "const": "outputs/isaac_audio_sensors/S4/S4.5_active_profile.v1.json"
    },
    "application_context": {
      "additionalProperties": false,
      "properties": {
        "array_frame": {
          "type": "string"
        },
        "array_id": {
          "type": "string"
        },
        "channel_order": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "coordinate_convention": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "device_model": {
          "type": "string"
        },
        "environment_tags": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "functional_association_frame": {
          "type": "string"
        },
        "functional_association_id": {
          "type": "string"
        },
        "functional_association_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "geometry_measurement_status": {
          "const": "nominal_not_measured"
        },
        "mount_fixture_id": {
          "type": "string"
        },
        "sample_rate_hz": {
          "minimum": 1,
          "type": "integer"
        },
        "source_frame": {
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "device_model",
        "array_id",
        "sample_rate_hz",
        "channel_order",
        "array_frame",
        "source_frame",
        "coordinate_convention",
        "mount_fixture_id",
        "environment_tags",
        "functional_association_id",
        "functional_association_frame",
        "functional_association_sha256",
        "geometry_measurement_status"
      ],
      "type": "object"
    },
    "mode": {
      "enum": [
        "apply",
        "off"
      ]
    },
    "schema": {
      "const": "ias.s4_6.profile_application_config.v1"
    },
    "status": {
      "const": "frozen"
    }
  },
  "required": [
    "schema",
    "status",
    "mode",
    "active_pointer_path",
    "application_context"
  ],
  "title": "S4.6 profile application configuration",
  "type": "object"
}
