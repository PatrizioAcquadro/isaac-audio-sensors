{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/isaac-audio-sensors/s4_8_heldout_evaluation.v1.schema.json",
  "title": "S4.8 held-out functional sim-to-real evaluation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "phase",
    "claimed_envelope",
    "prerequisite",
    "holdout",
    "profile_application",
    "criteria",
    "window_contract",
    "analysis",
    "grant",
    "evidence",
    "phase_boundary"
  ],
  "properties": {
    "schema": {"const": "ias.s4_8.heldout_evaluation_config.v1"},
    "status": {"const": "frozen_before_holdout_opening"},
    "phase": {"const": "S4.8"},
    "claimed_envelope": {
      "const": "controlled_source_single_room_single_mount"
    },
    "prerequisite": {"$ref": "#/$defs/prerequisite"},
    "holdout": {"$ref": "#/$defs/holdout"},
    "profile_application": {"$ref": "#/$defs/profile"},
    "criteria": {"$ref": "#/$defs/criteria"},
    "window_contract": {"$ref": "#/$defs/windows"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "grant": {"$ref": "#/$defs/grant"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "phase_boundary": {"$ref": "#/$defs/phaseBoundary"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^[^/].*"},
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "package_manifest_path",
        "package_manifest_sha256",
        "scientific_semantics_sha256",
        "corrective_id",
        "older_prerequisites_accepted"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "package_manifest_path": {"$ref": "#/$defs/path"},
        "package_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "scientific_semantics_sha256": {"$ref": "#/$defs/sha256"},
        "corrective_id": {"const": "s4_7_corrective_03"},
        "older_prerequisites_accepted": {"const": false}
      }
    },
    "holdout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound_holdout_id",
        "seal_path",
        "seal_file_sha256",
        "seal_payload_sha256",
        "partition_manifest_path",
        "partition_manifest_sha256",
        "split_plan_sha256",
        "session_manifest_path",
        "session_manifest_sha256",
        "dataset_attempt_root",
        "planned_take_count",
        "leakage_group_count",
        "sealed_artifact_count",
        "planned_denominator_policy"
      ],
      "properties": {
        "bound_holdout_id": {
          "const": "s4_4_data_expansion_amendment_03_prospective_holdout"
        },
        "seal_path": {"$ref": "#/$defs/path"},
        "seal_file_sha256": {"$ref": "#/$defs/sha256"},
        "seal_payload_sha256": {"$ref": "#/$defs/sha256"},
        "partition_manifest_path": {"$ref": "#/$defs/path"},
        "partition_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "split_plan_sha256": {"$ref": "#/$defs/sha256"},
        "session_manifest_path": {"$ref": "#/$defs/path"},
        "session_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_attempt_root": {"$ref": "#/$defs/path"},
        "planned_take_count": {"const": 47},
        "leakage_group_count": {"const": 15},
        "sealed_artifact_count": {"const": 160},
        "planned_denominator_policy": {
          "const": "all_47_planned_takes_retained"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_path",
        "config_sha256",
        "active_pointer_path",
        "active_pointer_sha256",
        "unadjusted_mode",
        "adjusted_mode",
        "required_adjusted_application_count"
      ],
      "properties": {
        "config_path": {"$ref": "#/$defs/path"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "active_pointer_path": {"$ref": "#/$defs/path"},
        "active_pointer_sha256": {"$ref": "#/$defs/sha256"},
        "unadjusted_mode": {"const": "off"},
        "adjusted_mode": {"const": "apply"},
        "required_adjusted_application_count": {"const": 7}
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v1_config_path",
        "v1_config_sha256",
        "corrective_config_path",
        "corrective_config_sha256",
        "corrective_schema_path",
        "corrective_schema_sha256",
        "delegated_config_path",
        "delegated_config_sha256",
        "delegated_schema_path",
        "delegated_schema_sha256",
        "readiness_count",
        "stretch_count",
        "readiness_pass_rule",
        "stretch_gating",
        "robustness_status",
        "robustness_denominator"
      ],
      "properties": {
        "v1_config_path": {"$ref": "#/$defs/path"},
        "v1_config_sha256": {"$ref": "#/$defs/sha256"},
        "corrective_config_path": {"$ref": "#/$defs/path"},
        "corrective_config_sha256": {"$ref": "#/$defs/sha256"},
        "corrective_schema_path": {"$ref": "#/$defs/path"},
        "corrective_schema_sha256": {"$ref": "#/$defs/sha256"},
        "delegated_config_path": {"$ref": "#/$defs/path"},
        "delegated_config_sha256": {"$ref": "#/$defs/sha256"},
        "delegated_schema_path": {"$ref": "#/$defs/path"},
        "delegated_schema_sha256": {"$ref": "#/$defs/sha256"},
        "readiness_count": {"const": 23},
        "stretch_count": {"const": 6},
        "readiness_pass_rule": {
          "const": "all_23_readiness_criteria_pass"
        },
        "stretch_gating": {"const": false},
        "robustness_status": {"const": "not_evaluable"},
        "robustness_denominator": {"const": 0}
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate_hz",
        "window_samples",
        "hop_samples",
        "expected_count_by_duration_s",
        "exact_contiguous_indices",
        "exact_window_identity"
      ],
      "properties": {
        "sample_rate_hz": {"const": 16000},
        "window_samples": {"const": 4000},
        "hop_samples": {"const": 2000},
        "expected_count_by_duration_s": {
          "const": {"15": 119, "20": 159}
        },
        "exact_contiguous_indices": {"const": true},
        "exact_window_identity": {"const": true}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s4_3_effective_config_path",
        "s4_3_effective_config_sha256",
        "transient_contract_path",
        "transient_contract_sha256",
        "av_expected_event_count",
        "av_expected_interval_s",
        "av_visual_search_half_width_ms",
        "av_visual_observable",
        "av_clock_basis"
      ],
      "properties": {
        "s4_3_effective_config_path": {"$ref": "#/$defs/path"},
        "s4_3_effective_config_sha256": {"$ref": "#/$defs/sha256"},
        "transient_contract_path": {"$ref": "#/$defs/path"},
        "transient_contract_sha256": {"$ref": "#/$defs/sha256"},
        "av_expected_event_count": {"const": 3},
        "av_expected_interval_s": {"const": 5.0},
        "av_visual_search_half_width_ms": {"const": 1000.0},
        "av_visual_observable": {
          "const": "mean_absolute_finite_depth_grid_delta"
        },
        "av_clock_basis": {
          "const": "audio_producer_and_zed_host_utc"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path",
        "ledger_path",
        "purpose",
        "grant_id_template",
        "authorization",
        "single_use",
        "consume_function",
        "serial_no_retry"
      ],
      "properties": {
        "schema": {"const": "ias.s4_4.holdout_access_grant.v1"},
        "path": {"const": "dataset/S4.8/access/holdout_access_grant.corrective_03.v1.json"},
        "ledger_path": {"const": "dataset/S4.8/access/access_ledger.jsonl"},
        "purpose": {"const": "S4.8_evaluation"},
        "grant_id_template": {
          "const": "s4_8_corrective_03_{source_commit}"
        },
        "authorization": {
          "const": "explicit_user_authorization_required"
        },
        "single_use": {"const": true},
        "consume_function": {
          "const": "isaac_audio_sensors.acquisition.s4_4.consume_s4_8_grant"
        },
        "serial_no_retry": {"const": true}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_input_path",
        "run_journal_path",
        "output_path",
        "closeout_path",
        "deterministic_replay_required",
        "raw_data_tracked",
        "grant_tracked",
        "ledger_tracked"
      ],
      "properties": {
        "derived_input_path": {"$ref": "#/$defs/path"},
        "run_journal_path": {
          "const": "dataset/S4.8/derived/first_run_journal.jsonl"
        },
        "output_path": {"const": "outputs/isaac_audio_sensors/S4/S4.8"},
        "closeout_path": {
          "const": "docs/development/closeouts/S4/s4_8_heldout_evaluation.md"
        },
        "deterministic_replay_required": {"const": true},
        "raw_data_tracked": {"const": false},
        "grant_tracked": {"const": false},
        "ledger_tracked": {"const": false}
      }
    },
    "phaseBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s4_9_started",
        "s5_started",
        "s6_started",
        "s4_complete_after_s4_8",
        "push_tag_release_authorized"
      ],
      "properties": {
        "s4_9_started": {"const": false},
        "s5_started": {"const": false},
        "s6_started": {"const": false},
        "s4_complete_after_s4_8": {"const": false},
        "push_tag_release_authorized": {"const": false}
      }
    }
  }
}
