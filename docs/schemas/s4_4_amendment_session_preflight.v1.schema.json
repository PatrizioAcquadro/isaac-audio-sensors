{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_session_preflight.v1.schema.json",
  "title": "S4.4 amendment session preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","session_id","session_date_local","checks","identity_contract_sha256","observations","preflight_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_session_preflight.v1"},
    "status": {"const": "passed"},
    "session_id": {"enum": ["fit_a","fit_b","prospective_holdout"]},
    "session_date_local": {"type": "string", "format": "date"},
    "checks": {"type": "object", "minProperties": 13, "additionalProperties": {"const": "passed"}},
    "identity_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observations": {"type": "object"},
    "preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
