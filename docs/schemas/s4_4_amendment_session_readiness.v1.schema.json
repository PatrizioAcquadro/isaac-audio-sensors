{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrizioAcquadro/isaac-audio-sensors/schemas/s4_4_amendment_session_readiness.v1.schema.json",
  "title": "S4.4 amendment pre-attempt session readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","status","amendment_id","session_id","session_date_local","collected_at_utc","precollection_seal_sha256","inherited_preflight_path","inherited_preflight_sha256","checks","observations","attempt_allocated","recorder_started","media_created","failure_retention_class","readiness_sha256"],
  "properties": {
    "schema": {"const": "ias.s4_4.amendment_session_readiness.v1"},
    "status": {"enum": ["passed","failed"]},
    "amendment_id": {"const": "s4_4_data_expansion_amendment_02"},
    "session_id": {"enum": ["fit_a","fit_b","prospective_holdout"]},
    "session_date_local": {"type": "string", "format": "date"},
    "collected_at_utc": {"type": "string", "format": "date-time"},
    "precollection_seal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inherited_preflight_path": {"type": "string"},
    "inherited_preflight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object", "minProperties": 12, "maxProperties": 12},
    "observations": {"type": "object"},
    "attempt_allocated": {"const": false},
    "recorder_started": {"const": false},
    "media_created": {"const": false},
    "failure_retention_class": {"type": ["string","null"]},
    "readiness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
